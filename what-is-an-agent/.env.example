# Pick a provider: "anthropic" | "openai" | "ollama"
# Default is "ollama" -- it's the only provider actually verified in this
# recipe's README (no paid API keys were available when it was built).
LLM_PROVIDER=ollama

# Ollama (local, free, no key needed) -- requires `ollama pull qwen3:4b` once.
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434

# Anthropic (supported, not exercised in this repo's verification run)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OpenAI (supported, not exercised in this repo's verification run)
# NOTE: OpenAI's current default model id was not independently verified
# during this project's research -- check platform.openai.com/docs/models
# for the current recommended id before relying on this default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
