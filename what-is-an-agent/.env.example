# This recipe reads credentials from the nearest .env, walking up from this
# folder -- by default that's agents-cookbook/.env at the cookbook root, so
# one paste there covers every recipe. Copy this file to a local .env in
# THIS folder only if you want to override the shared config for this
# recipe specifically.

# Pick a provider: "anthropic" | "openai" | "ollama"
LLM_PROVIDER=anthropic

# Anthropic (primary provider for this cookbook)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Ollama (local, free, no key -- optional fallback; requires `ollama pull qwen3:4b`)
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434

# OpenAI (supported, not the default; current model id not independently
# verified -- check platform.openai.com/docs/models before relying on this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
