# This recipe reads credentials from the nearest .env, walking up from this
# folder -- by default that's agents-cookbook/.env at the cookbook root, so
# one paste there covers every recipe. Copy this file to a local .env in
# THIS folder only if you want to override the shared config for this
# recipe specifically.

ANTHROPIC_API_KEY=
# Fallback for most calls in this recipe (simple generation/classification/
# review steps). The orchestrator-workers demo explicitly uses
# claude-sonnet-5 for its planning step, hardcoded in code, because
# deciding a sensible task breakdown needs more than Haiku-tier reasoning --
# see the recipe README for why.
ANTHROPIC_MODEL=claude-haiku-4-5
