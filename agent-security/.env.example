# This recipe reads credentials from the nearest .env, walking up from this
# folder -- by default that's agents-cookbook/.env at the cookbook root, so
# one paste there covers every recipe. Copy this file to a local .env in
# THIS folder only if you want to override the shared config for this
# recipe specifically.

ANTHROPIC_API_KEY=
# Both demos default to Haiku. Every "send" or "external" action in this
# recipe is a local, in-memory stub -- nothing here ever makes a real
# network call, regardless of what the model decides to do.
ANTHROPIC_MODEL=claude-haiku-4-5
