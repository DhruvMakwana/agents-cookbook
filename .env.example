# Shared credentials for every recipe in this cookbook. python-dotenv walks
# up from each recipe's llm.py to find the nearest .env -- placing it HERE,
# at the cookbook root, means pasting a key once covers every recipe. A
# recipe can still override by adding its own local .env in that folder.

# Pick a provider: "anthropic" | "openai" | "ollama"
LLM_PROVIDER=anthropic

# Anthropic (primary provider for this cookbook)
ANTHROPIC_API_KEY=
# Per-call model choice is task-scaled (see each recipe's code): Haiku for
# simple classification/judgment calls, Sonnet for anything needing real
# reasoning. This is the fallback when a recipe doesn't pass model= explicitly.
ANTHROPIC_MODEL=claude-haiku-4-5

# Ollama (local, free, no key -- optional fallback; requires `ollama pull qwen3:4b`)
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434

# OpenAI (supported, not the default; current model id not independently
# verified -- check platform.openai.com/docs/models before relying on this)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
